<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема приложения -->
    <style name="Theme.BullsAndCows.Material" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Стиль для игровых ячеек -->
    <style name="CellStyle">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/cell_background</item>
        <item name="android:textColor">@color/tbank_black</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <!-- Стиль для ячеек счёта -->
    <style name="ScoreCellStyle">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tbank_dark_gray</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <!-- Стиль для кнопок клавиатуры -->
    <style name="KeyboardButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/keyboard_button</item>
        <item name="android:textColor">@color/tbank_black</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <!-- Стиль для аналитических ячеек -->
    <style name="AnalyticsCellStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@drawable/cell_colored</item>
    </style>

    <!-- Стиль для основных кнопок -->
    <style name="MainButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/tbank_yellow</item>
        <item name="android:textColor">@color/tbank_black</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="KeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">#F0F0F0</item>
        <item name="android:textColor">#000000</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="KeyboardButtonHalf" parent="KeyboardButton">
        <item name="android:layout_weight">0.5</item>
    </style>


</resources>